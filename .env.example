# Copy this file to ".env" and fill in your own values before running the site.
# See README.md for full setup instructions.

# The password Jackie will use to log into /admin. Pick something she can remember
# but a stranger can't guess. Do NOT keep the example value below.
ADMIN_PASSWORD=change-this-password

# A long random string used to keep login sessions secure. Any long random text works.
# You can generate one by running:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string

# The port the site runs on. 3000 is fine unless something else on the Pi is using it.
PORT=3000
